<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BifrostUpdater</AssemblyName>
    <RootNamespace>BifrostUpdater</RootNamespace>
    <!-- The updater compares this against the latest GitHub release of Stanni97/bifrost-updater. -->
    <Version>1.0.2</Version>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Compile against the game's own runtime libraries, so no .NET Framework
         reference assemblies (and no NuGet download) are needed on any OS. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <!-- BifrostUpdater reads this to know where the mod's updates come from. -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="Stanni97/bifrost-updater" />
  </ItemGroup>

  <!-- Default Steam install locations. Override with: dotnet build -p:ValheimDir="/path/to/Valheim" -->
  <PropertyGroup Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">
    <ValheimDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ValheimDir)' == '' and '$(OS)' != 'Windows_NT'">
    <ValheimDir>$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
  </PropertyGroup>
  <PropertyGroup>
    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <PatchersDir>$(ValheimDir)/BepInEx/patchers</PatchersDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/mscorlib.dll" Private="false" />
    <Reference Include="$(ManagedDir)/netstandard.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.Core.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.IO.Compression.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.IO.Compression.FileSystem.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/core/Mono.Cecil.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckValheimDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/mscorlib.dll')"
           Text="Valheim not found at '$(ValheimDir)'. Pass the install folder with -p:ValheimDir=&quot;...&quot;" />
    <Error Condition="!Exists('$(ValheimDir)/BepInEx/core/BepInEx.dll')"
           Text="BepInEx is not installed in '$(ValheimDir)'. Install BepInExPack_Valheim first." />
  </Target>

  <!-- Copy the freshly built patcher into the game. Disable with -p:InstallToGame=false -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(InstallToGame)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PatchersDir)/BifrostUpdater" />
    <Message Importance="high" Text="Installed $(TargetFileName) to $(PatchersDir)/BifrostUpdater" />
  </Target>

  <!-- Release builds also produce a zip for dist/ (manifest.json for Thunderstore style mod managers). -->
  <Target Name="ReleasePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageDir>$(BaseIntermediateOutputPath)package</PackageDir>
      <ManifestJson>
{
  "name": "BifrostUpdater",
  "version_number": "$(Version)",
  "website_url": "https://github.com/Stanni97/bifrost-updater",
  "description": "Finds the installed BepInEx mods by itself and updates them from GitHub releases or Thunderstore when the game starts. Windows and Linux, no setup.",
  "dependencies": [
    "denikson-BepInExPack_Valheim-5.4.2333"
  ]
}
      </ManifestJson>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)/patchers" />
    <Copy SourceFiles="README.md;CHANGELOG.md;LICENSE" DestinationFolder="$(PackageDir)" />
    <WriteLinesToFile File="$(PackageDir)/manifest.json" Lines="$(ManifestJson.Trim())" Overwrite="true" />
    <MakeDir Directories="dist" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="dist/BifrostUpdater-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged dist/BifrostUpdater-$(Version).zip" />
  </Target>

</Project>
